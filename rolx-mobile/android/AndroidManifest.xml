<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom manifest for `dx` (see `android_manifest` in Dioxus.toml); based on dx 0.7's default.
  The native activity can't be recreated in-process (tao/ndk-context panic), so it must handle
  every runtime config change itself, e.g. switching to dark mode (`uiMode`) or the font size.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Lets the web view report `navigator.onLine` and the `online`/`offline` events (the app's offline status). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The "stamped in" notification, see src/native.rs; Android 13+ asks the user at the first stamp-in. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16 QPR2+ may show that notification as a Live Update: a chip in the status bar, the island on Xiaomi's
         HyperOS. Granted at install; the user can turn it off per app. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- The vibration when stamping in and out (granted at install). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- `ic_rolx` comes from the `plugin` module, see src/android.rs. A DayNight theme instead of dx's
         light `AppTheme`: the web view reports `prefers-color-scheme: dark` only if the app's theme is dark. -->
    <application android:hasCode="true" android:icon="@mipmap/ic_rolx"
        android:extractNativeLibs="true"
        android:allowNativeHeapPointerTagging="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:configChanges="orientation|screenLayout|screenSize|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density|fontScale|fontWeightAdjustment|locale|layoutDirection|colorMode|touchscreen|mcc|mnc"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name" android:name="dev.dioxus.main.MainActivity">
            <meta-data android:name="android.app.lib_name" android:value="main" />
            <meta-data android:name="android.app.func_name" android:value="ANativeActivity_onCreate" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Back to RolX" link on the browser page after the Google login, see `RETURN_URL` in main.rs. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ch.cudos.rolxmobile" />
            </intent-filter>
        </activity>
        <!-- Stamp links (`rolx://stamp?action=out`) from the app shortcuts, QR codes, Tasker and other apps: queues
             them for the app and opens it, without a window or a recents entry of its own. In the `plugin` module,
             see src/links.rs. -->
        <activity
            android:name="ch.cudos.rolxmobile.plugin.StampLinkActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="rolx" android:host="stamp" />
            </intent-filter>
        </activity>
    </application>
</manifest>
