<?xml version="1.0" encoding="utf-8"?>
<!-- The home-screen widget (StampWidget.kt). Only views RemoteViews supports. The texts are what the widget picker's
     preview shows; the widget replaces them right away. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="RolX"
            android:textColor="@color/widget_muted"
            android:textSize="12sp" />

        <Chronometer
            android:id="@+id/widget_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_fg"
            android:textSize="22sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Stamped out"
            android:textColor="@color/widget_fg"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- The activity; tapping it opens the picker (ActivityPicker.kt). -->
        <LinearLayout
            android:id="@+id/widget_activity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@drawable/widget_chip"
            android:contentDescription="@string/widget_pick_activity"
            android:gravity="center_vertical"
            android:minHeight="28dp"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/widget_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Choose an activity"
                android:textColor="@color/widget_fg"
                android:textSize="12sp" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_swap" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/widget_toggle"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/widget_button"
        android:contentDescription="@string/widget_stamp_in"
        android:scaleType="center"
        android:src="@drawable/ic_widget_play" />
</LinearLayout>
